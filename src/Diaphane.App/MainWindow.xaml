<Window
    x:Class="Diaphane.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:Diaphane.App"
    xmlns:browser="using:Diaphane.App.Browser"
    xmlns:tabs="using:Diaphane.Shell.Tabs"
    xmlns:data="using:Diaphane.Data">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" RowSpacing="0">
        <Grid.Resources>
            <local:BoolToVisibilityConverter x:Key="BoolVis" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="BookmarksColumn" Width="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Grid.ColumnSpan="3"
              Background="{ThemeResource ControlFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/diaphane-256.png" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Text="diaphane" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- tab strip -->
        <controls:TabView x:Name="TabStrip" Grid.Row="1" Grid.ColumnSpan="3"
                          VerticalAlignment="Top" Height="40"
                          IsAddTabButtonVisible="True"
                          AddTabButtonClick="OnAddTab"
                          SelectionChanged="OnTabSelectionChanged"
                          TabCloseRequested="OnTabClose"
                          CanReorderTabs="True" />

        <!-- left action rail (VSCode-style): every non-navigation browser action lives here -->
        <Grid Grid.Row="2" Grid.Column="0" Width="48"
              Background="{ThemeResource ControlFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                <StackPanel Orientation="Vertical" Spacing="3" Padding="4,8">
                    <ToggleButton Style="{StaticResource ActivityBarToggleButtonStyle}"
                                  Command="{x:Bind Vm.ToggleBookmarkCommand}"
                                  IsChecked="{x:Bind Vm.ActiveIsBookmarked, Mode=OneWay}"
                                  AutomationProperties.Name="Bookmark" ToolTipService.ToolTip="Bookmark (Ctrl+D)">
                        <FontIcon Glyph="&#xE734;" FontSize="18" />
                    </ToggleButton>
                    <Button Style="{StaticResource ActivityBarButtonStyle}"
                            AutomationProperties.Name="History" ToolTipService.ToolTip="History (Ctrl+H)">
                        <FontIcon Glyph="&#xE81C;" FontSize="18" />
                        <Button.Flyout>
                            <Flyout Opening="OnHistoryFlyoutOpening" Placement="Right">
                                <StackPanel Width="420" Spacing="6">
                                    <Grid>
                                        <TextBlock Text="History" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <HyperlinkButton Content="Clear all" HorizontalAlignment="Right"
                                                         Command="{x:Bind Vm.ClearHistoryCommand}" />
                                    </Grid>
                                    <ListView x:Name="HistoryList" MaxHeight="380" SelectionMode="None"
                                              IsItemClickEnabled="True" ItemClick="OnHistoryItemClick">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="data:VisitEntry">
                                                <StackPanel>
                                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Url}" FontSize="11" Opacity="0.6"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Rectangle Height="1" Margin="8,3" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Button Style="{StaticResource ActivityBarButtonStyle}"
                            Command="{x:Bind Vm.NewSandboxTabCommand}"
                            AutomationProperties.Name="New Sandbox tab" ToolTipService.ToolTip="New Sandbox tab (Ctrl+Shift+N)">
                        <FontIcon Glyph="&#xE727;" FontSize="18" Foreground="#B39DDB" />
                    </Button>
                    <ToggleButton Style="{StaticResource ActivityBarToggleButtonStyle}"
                                  Command="{x:Bind Vm.ToggleBookmarksBarCommand}"
                                  IsChecked="{x:Bind Vm.ShowBookmarksBar, Mode=OneWay}"
                                  AutomationProperties.Name="Bookmarks panel" ToolTipService.ToolTip="Bookmarks panel (Ctrl+Shift+B)">
                        <FontIcon Glyph="&#xE8A4;" FontSize="18" />
                    </ToggleButton>
                    <Rectangle Height="1" Margin="8,3" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <ToggleButton Style="{StaticResource ActivityBarToggleButtonStyle}"
                                  Command="{x:Bind Vm.ToggleExtensionsPanelCommand}"
                                  IsChecked="{x:Bind Vm.ShowExtensionsPanel, Mode=OneWay}"
                                  AutomationProperties.Name="Extensions" ToolTipService.ToolTip="Extensions (Ctrl+Shift+E)">
                        <FontIcon Glyph="&#xEA86;" FontSize="18" />
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ActivityBarToggleButtonStyle}"
                                  Command="{x:Bind Vm.ToggleMediaPanelCommand}"
                                  IsChecked="{x:Bind Vm.ShowMediaPanel, Mode=OneWay}"
                                  AutomationProperties.Name="Media and codecs" ToolTipService.ToolTip="Media &amp; codecs (Ctrl+Shift+M)">
                        <FontIcon Glyph="&#xE714;" FontSize="18" />
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ActivityBarToggleButtonStyle}"
                                  Command="{x:Bind Vm.ToggleDevToolsCommand}"
                                  IsChecked="{x:Bind Vm.ShowDevTools, Mode=OneWay}"
                                  AutomationProperties.Name="DevTools" ToolTipService.ToolTip="DevTools (F12)">
                        <FontIcon Glyph="&#xEBE8;" FontSize="18" />
                    </ToggleButton>
                </StackPanel>
            </ScrollViewer>

            <!-- pinned to the bottom, like Docket's status/settings group -->
            <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="3" Padding="4,8">
                <Rectangle Height="1" Margin="8,3" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <ToggleButton Style="{StaticResource ActivityBarToggleButtonStyle}"
                              Command="{x:Bind Vm.TogglePrivacyPanelCommand}"
                              IsChecked="{x:Bind Vm.ShowPrivacyPanel, Mode=OneWay}"
                              AutomationProperties.Name="Clear browsing data" ToolTipService.ToolTip="Clear browsing data (Ctrl+Shift+Del)">
                    <FontIcon Glyph="&#xE72E;" FontSize="18" />
                </ToggleButton>
                <ToggleButton Style="{StaticResource ActivityBarToggleButtonStyle}"
                              Command="{x:Bind Vm.ToggleSettingsPanelCommand}"
                              IsChecked="{x:Bind Vm.ShowSettingsPanel, Mode=OneWay}"
                              AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="18" />
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- bookmarks panel: groups + bookmarks, vertical, drag-and-drop into groups -->
        <Grid Grid.Row="2" Grid.Column="1" x:Name="BookmarksPanel"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Visibility="{x:Bind local:MainWindow.VisIf(Vm.ShowBookmarksBar), Mode=OneWay}"
              AllowDrop="True" DragOver="BookmarksRoot_DragOver" Drop="BookmarksRoot_Drop"
              RightTapped="BookmarksTree_RightTapped">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Bookmarks" FontWeight="SemiBold" Margin="12,10,12,4" />

            <TreeView Grid.Row="1" x:Name="BookmarksTree" Margin="4,0,4,4" SelectionMode="None"
                      ItemsSource="{x:Bind Vm.BookmarkTree, Mode=OneWay}"
                      ItemInvoked="BookmarksTree_ItemInvoked"
                      RightTapped="BookmarksTree_RightTapped">
                <TreeView.ItemTemplate>
                    <DataTemplate>
                        <TreeViewItem ItemsSource="{Binding Children}"
                                      IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Grid Background="Transparent" Padding="2,3" ColumnSpacing="8"
                                  CanDrag="True" DragStarting="BookmarkRow_DragStarting"
                                  DropCompleted="BookmarkRow_DropCompleted"
                                  AllowDrop="True" DragEnter="BookmarkRow_DragOver"
                                  DragOver="BookmarkRow_DragOver" Drop="BookmarkRow_Drop">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="{Binding Glyph}" FontSize="14"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </TreeViewItem>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>

        <Rectangle Grid.Row="2" Grid.Column="1" x:Name="BookmarksSplitter" Width="6" HorizontalAlignment="Right"
                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                   Visibility="{x:Bind local:MainWindow.VisIf(Vm.ShowBookmarksBar), Mode=OneWay}"
                   PointerPressed="OnBookmarksSplitterPressed"
                   PointerMoved="OnBookmarksSplitterMoved"
                   PointerReleased="OnBookmarksSplitterReleased" />

        <!-- main content: toolbar / browser surface -->
        <Grid Grid.Row="2" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- toolbar: navigation only — every other action lives in the left rail -->
            <Grid Grid.Row="0" Height="44" Padding="8,4" ColumnSpacing="4"
                  Background="{x:Bind local:MainWindow.ToolbarBrush(Vm.ActiveIsSandbox), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource ActivityBarButtonStyle}"
                        Command="{x:Bind Vm.GoBackCommand}" ToolTipService.ToolTip="Back (Alt+Left)">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <Button Grid.Column="1" Style="{StaticResource ActivityBarButtonStyle}"
                        Command="{x:Bind Vm.GoForwardCommand}" ToolTipService.ToolTip="Forward (Alt+Right)">
                    <FontIcon Glyph="&#xE72A;" FontSize="14" />
                </Button>
                <Button Grid.Column="2" Style="{StaticResource ActivityBarButtonStyle}"
                        Command="{x:Bind Vm.ReloadCommand}" ToolTipService.ToolTip="Reload (F5)">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <Button Grid.Column="3" Style="{StaticResource ActivityBarButtonStyle}"
                        Command="{x:Bind Vm.GoHomeCommand}" ToolTipService.ToolTip="Home">
                    <FontIcon Glyph="&#xE80F;" FontSize="14" />
                </Button>

                <!-- same treatment as Docket's Command Palette bar: rounded, rail-coloured chrome -->
                <AutoSuggestBox x:Name="Address" Grid.Column="4" VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6"
                                PlaceholderText="Search or enter address"
                                QueryIcon="Find"
                                Text="{x:Bind Vm.AddressText, Mode=TwoWay}"
                                TextChanged="OnAddressTextChanged"
                                QuerySubmitted="OnAddressSubmitted"
                                SuggestionChosen="OnSuggestionChosen" />
            </Grid>

            <!-- CEF off-screen surface + docked DevTools pane -->
            <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="DevToolsColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="BrowserRegion" Grid.Column="0" SizeChanged="OnBrowserRegionChanged">
                <ScrollViewer x:Name="BrowserFocus" IsTabStop="True" UseSystemFocusVisuals="False"
                              HorizontalScrollMode="Disabled" VerticalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                              LostFocus="OnPageLostFocus"
                              KeyDown="OnKeyDown" KeyUp="OnKeyUp" CharacterReceived="OnChar">
                    <Image x:Name="BrowserImage" Stretch="None"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           ManipulationMode="None"
                           PointerMoved="OnPointerMoved" PointerPressed="OnPointerPressed"
                           PointerReleased="OnPointerReleased" PointerExited="OnPointerExited"
                           PointerWheelChanged="OnPointerWheel" />
                </ScrollViewer>
                <ProgressBar x:Name="LoadBar" VerticalAlignment="Top" IsIndeterminate="True"
                             Visibility="Collapsed" />
            </Grid>

            <Border x:Name="DevToolsSplitter" Grid.Column="1" Width="6"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Visibility="Collapsed"
                    PointerPressed="OnDevSplitterPressed"
                    PointerMoved="OnDevSplitterMoved"
                    PointerReleased="OnDevSplitterReleased" />

            <Grid x:Name="DevToolsRegion" Grid.Column="2" SizeChanged="OnDevToolsRegionChanged">
                <ScrollViewer x:Name="DevToolsFocus" IsTabStop="True" UseSystemFocusVisuals="False"
                              HorizontalScrollMode="Disabled" VerticalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                              LostFocus="OnDevLostFocus"
                              KeyDown="OnDevKeyDown" KeyUp="OnDevKeyUp" CharacterReceived="OnDevChar">
                    <Image x:Name="DevToolsImage" Stretch="None"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           ManipulationMode="None"
                           PointerMoved="OnDevPointerMoved" PointerPressed="OnDevPointerPressed"
                           PointerReleased="OnDevPointerReleased" PointerExited="OnDevPointerExited"
                           PointerWheelChanged="OnDevPointerWheel" />
                </ScrollViewer>
            </Grid>
            </Grid>
        </Grid>

        <!-- diaphane://privacy — Clear browsing data -->
        <Grid Grid.Row="2" Grid.ColumnSpan="3" Background="#99000000"
              Visibility="{x:Bind local:MainWindow.VisIf(Vm.ShowPrivacyPanel), Mode=OneWay}">
            <Border MaxWidth="460" Margin="24" Padding="24" VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock Text="Clear browsing data" FontSize="18" FontWeight="SemiBold" />

                    <ComboBox Header="Time range" HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind Vm.Privacy.TimeRanges}"
                              SelectedIndex="{x:Bind Vm.Privacy.TimeRangeIndex, Mode=TwoWay}" />

                    <CheckBox Content="Cookies and other site data"
                              IsChecked="{x:Bind Vm.Privacy.ClearCookies, Mode=TwoWay}" />
                    <CheckBox Content="Site storage (localStorage, IndexedDB)"
                              IsChecked="{x:Bind Vm.Privacy.ClearSiteStorage, Mode=TwoWay}" />
                    <CheckBox Content="Cached files and images"
                              IsChecked="{x:Bind Vm.Privacy.ClearHttpCache, Mode=TwoWay}" />
                    <CheckBox Content="Browsing history"
                              IsChecked="{x:Bind Vm.Privacy.ClearHistory, Mode=TwoWay}" />
                    <CheckBox Content="DNS cache and open connections"
                              IsChecked="{x:Bind Vm.Privacy.ClearDnsCache, Mode=TwoWay}" />

                    <TextBlock Text="{x:Bind Vm.Privacy.LastResult, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind local:MainWindow.VisIfText(Vm.Privacy.LastResult), Mode=OneWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Close" Command="{x:Bind Vm.ClosePrivacyPanelCommand}" />
                        <Button Content="Clear now" Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind Vm.Privacy.ClearNowCommand}"
                                IsEnabled="{x:Bind local:MainWindow.Not(Vm.Privacy.Busy), Mode=OneWay}" />
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />

                    <CheckBox Content="Clear cookies, cache, storage and history every time diaphane closes"
                              IsChecked="{x:Bind Vm.Privacy.ClearOnExit, Mode=TwoWay}" />
                    <CheckBox IsChecked="{x:Bind Vm.Privacy.AllowWidevine, Mode=TwoWay}">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Allow the Widevine DRM module (off by default). Even when on, diaphane never downloads it — DRM video only works if the module is already present. Takes effect on restart." />
                    </CheckBox>
                    <CheckBox IsChecked="{x:Bind Vm.Privacy.EnableDevTools, Mode=TwoWay}">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Enable DevTools (F12). Uses a 127.0.0.1-only debugging port. Turn off to close that port entirely. Takes effect on restart." />
                    </CheckBox>
                </StackPanel>
            </Border>
        </Grid>

        <!-- diaphane://extensions -->
        <Grid Grid.Row="2" Grid.ColumnSpan="3" Background="#99000000"
              Visibility="{x:Bind local:MainWindow.VisIf(Vm.ShowExtensionsPanel), Mode=OneWay}">
            <Border MaxWidth="560" MaxHeight="620" Margin="24" Padding="24" VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Extensions" FontSize="18" FontWeight="SemiBold" />

                    <TextBlock Grid.Row="1" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Load an unpacked extension folder (one containing manifest.json). diaphane never fetches or updates extensions on its own." />

                    <InfoBar Grid.Row="2" IsOpen="{x:Bind Vm.Extensions.RestartNeeded, Mode=OneWay}"
                             Severity="Informational" IsClosable="False"
                             Message="Restart diaphane to apply extension changes." />

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" MinHeight="80">
                        <ItemsControl ItemsSource="{x:Bind Vm.Extensions.Items, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="browser:ExtensionRow">
                                    <Border Padding="12" Margin="0,0,0,8" CornerRadius="6"
                                            Background="{ThemeResource LayerFillColorAltBrush}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ToggleSwitch Grid.Column="0" MinWidth="0"
                                                          IsOn="{x:Bind Enabled, Mode=TwoWay}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                                <TextBlock FontSize="12" Opacity="0.7" Text="{x:Bind Version, Mode=OneWay}" />
                                                <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                                                           Text="{x:Bind Permissions}" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Remove"
                                                    Click="OnRemoveExtensionClick" Tag="{x:Bind}"
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="4" Spacing="8">
                        <TextBlock Text="{x:Bind Vm.Extensions.Status, Mode=OneWay}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind local:MainWindow.VisIfText(Vm.Extensions.Status), Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="Close" Command="{x:Bind Vm.CloseExtensionsPanelCommand}" />
                            <Button Content="Check for updates" Command="{x:Bind Vm.Extensions.CheckForUpdatesCommand}" />
                            <Button Content="Load unpacked…" Style="{ThemeResource AccentButtonStyle}"
                                    Click="OnLoadUnpackedClick" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- diaphane://media -->
        <Grid Grid.Row="2" Grid.ColumnSpan="3" Background="#99000000"
              Visibility="{x:Bind local:MainWindow.VisIf(Vm.ShowMediaPanel), Mode=OneWay}">
            <Border MaxWidth="560" MaxHeight="640" Margin="24" Padding="24" VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Media &amp; codecs" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="What this build can actually decode, probed live in the active tab. Nothing is sent anywhere." />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MinHeight="120">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Codec" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="canPlayType" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Grid.Column="2" Text="MSE" FontWeight="SemiBold" FontSize="12" />
                                </Grid>
                                <ItemsControl ItemsSource="{x:Bind Vm.MediaTools.Codecs, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="browser:CodecRow">
                                            <Grid Padding="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind Name}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Playback}" Opacity="0.8" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind MediaSource}" Opacity="0.8" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="DRM key systems (EME)" FontWeight="SemiBold" FontSize="12" />
                                <ItemsControl ItemsSource="{x:Bind Vm.MediaTools.KeySystems, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="browser:KeySystemRow">
                                            <Grid Padding="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="130" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind Name}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Status}" Opacity="0.8" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock Grid.Row="3" Text="{x:Bind Vm.MediaTools.Status, Mode=OneWay}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Close" Command="{x:Bind Vm.CloseMediaPanelCommand}" />
                        <Button Content="Run probe" Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind Vm.MediaTools.ProbeCommand}"
                                IsEnabled="{x:Bind local:MainWindow.Not(Vm.MediaTools.Busy), Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- diaphane://settings -->
        <Grid Grid.Row="2" Grid.ColumnSpan="3" Background="#99000000"
              Visibility="{x:Bind local:MainWindow.VisIf(Vm.ShowSettingsPanel), Mode=OneWay}">
            <Border MaxWidth="520" MaxHeight="680" Margin="24" Padding="24" VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Settings" FontSize="18" FontWeight="SemiBold" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <ComboBox Header="On startup" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind Vm.Settings.StartupModes}"
                                      SelectedIndex="{x:Bind Vm.Settings.StartupIndex, Mode=TwoWay}" />
                            <TextBox Header="Homepage" PlaceholderText="about:blank"
                                     Text="{x:Bind Vm.Settings.Homepage, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <ComboBox Header="Search engine" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind Vm.Settings.SearchEngineNames}"
                                      SelectedIndex="{x:Bind Vm.Settings.SearchEngineIndex, Mode=TwoWay}" />
                            <TextBox Header="Custom search URL ({q} = query)"
                                     PlaceholderText="https://example.com/search?q={q}"
                                     Visibility="{x:Bind local:MainWindow.VisIf(Vm.Settings.IsCustomSearch), Mode=OneWay}"
                                     Text="{x:Bind Vm.Settings.CustomSearchUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <ComboBox Header="Appearance" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind Vm.Settings.Themes}"
                                      SelectedIndex="{x:Bind Vm.Settings.ThemeIndex, Mode=TwoWay}" />

                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <StackPanel Spacing="6">
                                <TextBlock Text="Updates" FontWeight="SemiBold" />
                                <TextBlock TextWrapping="Wrap" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="diaphane never checks for updates on its own. Point this at a JSON manifest and use the button." />
                                <TextBox PlaceholderText="https://…/latest.json"
                                         Text="{x:Bind Vm.Settings.UpdateManifestUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="{x:Bind Vm.Settings.UpdateStatus, Mode=OneWay}" TextWrapping="Wrap"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{x:Bind local:MainWindow.VisIfText(Vm.Settings.UpdateStatus), Mode=OneWay}" />
                                <HyperlinkButton Content="Open the download page"
                                                 Click="OnOpenUpdateDownload"
                                                 Visibility="{x:Bind local:MainWindow.VisIfText(Vm.Settings.UpdateDownloadUrl), Mode=OneWay}" />
                            </StackPanel>

                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind Vm.Settings.EngineVersion, Mode=OneWay}" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Close" Command="{x:Bind Vm.CloseSettingsPanelCommand}" />
                        <Button Content="Check for updates"
                                Command="{x:Bind Vm.Settings.CheckForUpdatesCommand}"
                                IsEnabled="{x:Bind local:MainWindow.Not(Vm.Settings.CheckingUpdate), Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
