# diaphane engine GN args. Consumed by: gn gen out/Release --args="$(cat build/args.gn)"
is_official_build            = true
is_debug                    = false
target_cpu                  = "x64"

# Media
proprietary_codecs          = true
ffmpeg_branding             = "Chrome"          # H.264 / AAC decode
enable_widevine             = false             # opt-in component only; never auto-fetched

# Kill Google callbacks (ungoogled patches cover most; these are belt-and-braces)
safe_browsing_mode          = 0
enable_reporting            = false
enable_hangout_services_extension = false
use_official_google_api_keys = false
google_api_key              = ""
google_default_client_id    = ""
google_default_client_secret = ""
enable_mdns                 = false
enable_service_discovery    = false

# Keep the sandbox on. Non-negotiable.
# (no flag = default enabled; do not add disable-sandbox anywhere)
